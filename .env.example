# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/jobqueue
# For local SQLite development without Postgres, you can use:
# DATABASE_URL=sqlite+aiosqlite:///./jobqueue.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
SECRET_KEY=super-secret-distributed-job-queue-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Initial Administrator
ADMIN_EMAIL=admin@jobqueue.io
ADMIN_PASSWORD=Admin@123456

# Queue & Retry Defaults
DEFAULT_MAX_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=5
DEFAULT_JOB_TIMEOUT_SECONDS=120
LEASE_TIMEOUT_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=5
